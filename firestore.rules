rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /purchases/{purchaseId} {
      allow read, delete: if true;
      allow create, update: if !exists(/databases/$(database)/documents/deletedPurchases/$(purchaseId));
    }
    match /newPurchases/{newPurchaseId} {
      allow read, delete: if true;
      allow create, update: if !exists(/databases/$(database)/documents/deletedPurchases/$(newPurchaseId));
    }
    match /deletedPurchases/{deletedId} {
      allow read, write: if true;
    }
    match /cards/{cardId} {
      allow read, write: if true;
    }
    match /responsibles/{respId} {
      allow read, write: if true;
    }
    match /statements/{stmtId} {
      allow read, write: if true;
    }
    match /adminFees/{feeId} {
      allow read, write: if true;
    }
  }
}
